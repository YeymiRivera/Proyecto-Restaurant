  @page "/producto"
    @using proyecto.Models
    @using proyecto.Services
    @using Microsoft.AspNetCore.Components.Forms
    @inject ProductoService ProductoService
    @inject RhdbContext Context
    @rendermode InteractiveServer
    <h3>Gestión de Productos</h3>
    <div class="card p-3 mb-4">
        <h5>@(ModoEdicion ? "Modificar Plato" : "Nuevo Plato")</h5>
        <div class="mb-3">
            <label class="form-label">
                Nombre del plato
            </label>

            <input class="form-control"
                @bind="NuevoProducto.Nombre" />

        </div>
        <div class="mb-3">

            <label class="form-label">
                Descripción
            </label>

            <textarea class="form-control"
                    @bind="NuevoProducto.Descripcion">
            </textarea>
        </div>
        <div class="mb-3">

            <label class="form-label">
                Precio
            </label>
            <input type="number"
                class="form-control"
                @bind="NuevoProducto.Precio" />

        </div>
        <div class="mb-3">

            <label class="form-label">
                Categoría
            </label>
            <select class="form-select"
                    @bind="NuevoProducto.IdCategoria">
                <option value="0">
                    Seleccione categoría
                </option>
                @foreach(var categoria in Categorias)
                {

                    <option value="@categoria.IdCategoria">
                        @categoria.Nombre
                    </option>
                }
            </select>
        </div>
    <div class="mb-3">

    <label class="form-label">
        URL de la imagen
    </label>

    <input type="url"
           class="form-control"
           @bind:event="oninput"
           @bind="NuevoProducto.Image"
           placeholder="https://ejemplo.com/imagen.jpg" />

    <div class="form-text">
        Pega la URL de una imagen para el plato.
    </div>

</div>

@if (!string.IsNullOrWhiteSpace(NuevoProducto.Image))
{
    <div class="mb-3">

        <label class="form-label">
            Vista previa
        </label>

        <div class="mt-2">
            <img src="@NuevoProducto.Image"
                 alt="Vista previa del plato"
                 class="img-thumbnail"
                 style="max-width:250px;
                        max-height:250px;
                        object-fit:cover;" />
        </div>

    </div>
}
       @if (!ModoEdicion)
{
    <button class="btn btn-primary"
            @onclick="GuardarProducto">
        Guardar Plato
    </button>
}
else
{
    <button class="btn btn-success me-2"
            @onclick="ActualizarProducto">
        Actualizar
    </button>

    <button class="btn btn-secondary"
            @onclick="CancelarEdicion">
        Cancelar
    </button>
}
    </div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Productos registrados</h4>

    <input class="form-control w-25"
           placeholder="Buscar producto..."
           @bind="TextoBusqueda"
           @bind:event="oninput" />
</div>

<table class="table table-striped table-hover align-middle">

    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Estado</th>
            <th style="width:180px;">Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var producto in ProductosFiltrados)
        {
            <tr>

                <td>@producto.Nombre</td>

                <td>
                    @Categorias.FirstOrDefault(c => c.IdCategoria == producto.IdCategoria)?.Nombre
                </td>

                <td>@producto.Precio.ToString("C")</td>

                <td>

                    @if (producto.Estado)
                    {
                        <span class="badge bg-success">
                            Disponible
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo
                        </span>
                    }

                </td>

                <td>

                    <button class="btn btn-warning btn-sm me-2"
                            @onclick="() => EditarProducto(producto)">
                        Modificar
                    </button>

                    <button class="btn btn-danger btn-sm"
                            @onclick="() => EliminarProducto(producto.IdProducto)">
                        Eliminar
                    </button>

                </td>

            </tr>
        }

    </tbody>

</table>
    @code {
    private bool ModoEdicion = false;
private int IdProductoEditando = 0;
private Producto NuevoProducto = new();
private string TextoBusqueda = "";
private IEnumerable<Producto> ProductosFiltrados =>
    Productos.Where(p =>
        string.IsNullOrWhiteSpace(TextoBusqueda)
        || p.Nombre.Contains(TextoBusqueda,
            StringComparison.OrdinalIgnoreCase));
        private List<Producto> Productos = new();
        private List<Categorium> Categorias = new();

protected override async Task OnInitializedAsync()
        {
          try
    {
        Productos = await ProductoService.ObtenerProductos();
        Categorias = await ProductoService.ObtenerCategorias();
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex.ToString());
        throw;
    }
        }
        private async Task GuardarProducto()
        {
            NuevoProducto.Estado = true;
            await ProductoService
                .CrearProducto(NuevoProducto);
            Productos =
                await ProductoService
                .ObtenerProductos();
            NuevoProducto = new();

        }
        private async Task EliminarProducto(int id)
{
    await ProductoService.EliminarProducto(id);

    Productos = await ProductoService.ObtenerProductos();
}

private void EditarProducto(Producto producto)
{
    IdProductoEditando = producto.IdProducto;

    NuevoProducto = new Producto
    {
        IdProducto = producto.IdProducto,
        Nombre = producto.Nombre,
        Descripcion = producto.Descripcion,
        Precio = producto.Precio,
        Estado = producto.Estado,
        IdCategoria = producto.IdCategoria,
        Image = producto.Image
    };

    ModoEdicion = true;
}
private async Task ActualizarProducto()
{
    try
    {
        await ProductoService.ActualizarProducto(NuevoProducto);

        Productos = await ProductoService.ObtenerProductos();

        NuevoProducto = new Producto();

        IdProductoEditando = 0;
        ModoEdicion = false;
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex.ToString());
    }
}
private void CancelarEdicion()
{
    NuevoProducto = new Producto();

    IdProductoEditando = 0;

    ModoEdicion = false;
}

    }